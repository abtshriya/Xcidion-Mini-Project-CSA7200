# ============================================================
#  XCIDION — Explainable Network Intrusion Detection System
#  Environment Configuration Template
#  Copy to .env and populate before running in production.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# If unset, application falls back to a local SQLite database.
DATABASE_URL=postgresql://xcidion:xcidion_password@localhost:5432/xcidion_db

# ── Security ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_use_a_64_char_hex_string_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Application Ports ────────────────────────────────────────
BACKEND_PORT=8000
FRONTEND_PORT=3000

# ── Network Monitoring Tools ─────────────────────────────────
# Full paths to monitoring binaries; leave empty to use PATH
TSHARK_PATH=
SURICATA_PATH=
ZEEK_PATH=
SURICATA_RULES_DIR=

# ── File Storage Paths ───────────────────────────────────────
PCAP_UPLOAD_DIR=./data/pcaps
ML_MODELS_DIR=./models
LOGS_DIR=./data/logs

# ── Optional: Suricata integration ───────────────────────────
# Set the path to your eve.json output file for live ingestion
SURICATA_EVE_LOG=

# ── Optional: Zeek integration ───────────────────────────────
# Set the path to your conn.log output directory for live ingestion
ZEEK_LOG_DIR=
